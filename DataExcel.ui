  <property name="styleSheet">
   <string notr="true">/* ===== 全局 ===== */
QWidget#DataExcelClass {
    background-color: #f5f7fa;
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, &quot;PingFang SC&quot;, sans-serif;
}

/* ===== TabWidget 容器 ===== */
QTabWidget::pane {
    border: 1px solid #dce1e8;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

/* ===== Tab 标签 ===== */
QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #eef1f5;
    color: #5a6a7a;
    border: 1px solid #dce1e8;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 28px;
    margin-right: 4px;
    font-size: 15px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2c6bed;
    border-bottom: 2px solid #2c6bed;
}

QTabBar::tab:hover:!selected {
    background-color: #e3e8ef;
    color: #3a4a5a;
}

/* ===== 表格 ===== */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #2c3e50;
    gridline-color: #e8ecf1;
    border: 1px solid #dce1e8;
    border-radius: 6px;
    selection-background-color: #d6e4ff;
    selection-color: #1a3a6b;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #d6e4ff;
    color: #1a3a6b;
}

QTableWidget::item:hover {
    background-color: #eef4ff;
}

/* ===== 表头 ===== */
QHeaderView::section {
    background-color: #f0f3f8;
    color: #3a4a5a;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #e0e5ec;
    border-bottom: 2px solid #d0d7e2;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #f0f3f8;
    border: none;
}

/* ===== 按钮 ===== */
QPushButton {
    color: #ffffff;
    background-color: #2c6bed;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #1e5bd6;
}

QPushButton:pressed {
    background-color: #1749b8;
}

QPushButton:disabled {
    background-color: #b8c4d6;
    color: #eef1f5;
}

/* ===== 输入框 ===== */
QLineEdit {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d0d7e2;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: #d6e4ff;
    selection-color: #1a3a6b;
}

QLineEdit:focus {
    border: 1px solid #2c6bed;
    background-color: #fafcff;
}

QLineEdit:hover:!focus {
    border: 1px solid #b8c4d6;
}

/* ===== 标签 ===== */
QLabel {
    color: #5a6a7a;
    font-size: 13px;
    background: transparent;
}

QLabel#labelUnit_A,
QLabel#labelUnit_B {
    color: #8899aa;
    font-size: 12px;
    font-style: italic;
}
</string>
