    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

/* 选中状态，无论是否有焦点，都使用深灰背景 */
QTableWidget::item:selected,
QTableWidget::item:selected:focus,
QTableWidget::item:selected:!focus {
    background-color: #555555 !important;
    color: white !important;
}

/* 鼠标悬停时高亮 */
QTableWidget::item:hover {
    background-color:rgb(160, 185, 217);
}

/* 表头样式 */
QHeaderView::section {
    background-color: #f0f0f0;
    color: #3a3a3a;
    padding: 6px 10px;
    border: 1px solid #cccccc;
    font-weight: bold;
}
