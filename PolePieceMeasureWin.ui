    outline: none;
    transition: all 0.15s ease-in-out;
    padding: 6px 14px;
    /* 双层边框实现立体效果 */
    border: 4px solid rgba(80, 80, 80, 0.8); /* 外层深灰色边框 */
    border-top: 4px solid rgba(120, 120, 120, 0.9);
    border-left: 4px solid rgba(120, 120, 120, 0.9);
    /* 内层边框效果 */
    background-clip: padding-box;
    position: relative;
}

QPushButton::before {
    content: &quot;&quot;;
    position: absolute;
    top: 1px;
    left: 1px;
    right: 1px;
    bottom: 1px;
    border: 1px solid rgba(30, 30, 30, 0.9);
    border-radius: 3px;
    pointer-events: none;
}

QPushButton:hover {
    background-color: rgb(162, 162, 162);
    border-color: rgba(100, 100, 100, 0.9);
    border-top-color: rgba(140, 140, 140, 0.9);
    border-left-color: rgba(140, 140, 140, 0.9);
}

QPushButton:pressed {
    background-color: #252A32;
    color: #C8CDD1;
    /* 按下时反转边框明暗 */
    border: 1px solid rgba(60, 60, 60, 0.9);
    border-bottom-color: rgba(100, 100, 100, 0.9);
    border-right-color: rgba(100, 100, 100, 0.9);
}

QPushButton:disabled {
    background-color: #E3E7EB;
    color: #A0A6AC;
    border: 1px solid rgba(150, 150, 150, 0.6);
}</string>
