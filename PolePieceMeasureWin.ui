          <property name="styleSheet">
           <string notr="true">QGroupBox {
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #5A81A8, stop:1 #274472); /* 工业蓝渐变 */
    border-radius: 10px;
    background-color: rgba(230, 238, 245, 90%); /* 浅蓝灰，清爽专业 */
    margin-top: 20px;
}

QGroupBox::title {
    color: #FFFFFF;
    background-color: #274472; /* 深钢蓝，科技感强 */
    font: 75 12pt &quot;Microsoft YaHei UI&quot;;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 16px;
    border-radius: 6px;
}

/* 禁用状态 */
QGroupBox:disabled {
    border-color: #A5B7C6;  /* 工业蓝灰 */
    color: #95A5A6;
}

QGroupBox QCheckBox {
    color: #274472; /* 深钢蓝，与标题呼应 */
}
QGroupBox {
    background-color: rgba(42, 42, 42, 0.95); /* 轻微透明度 */
    color: white;
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #5A81A8, stop:1 #274472);
    border-radius: 10px;
    margin-top: 20px;
}
QGroupBox {
    background-color: #1e1e1e; /* 更深的浅黑色 */
    color: white;
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #5A81A8, stop:1 #274472);
    border-radius: 10px;
    margin-top: 20px;
}

QGroupBox::title {
    background-color: #006498; /* 深钢蓝 */
    color: white;
}</string>
