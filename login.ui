  <property name="styleSheet">
   <string notr="true">/* ============ 全局背景：深空渐变 ============ */
QWidget#LogIn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #050a14,
                                stop:0.45 #0a1b33,
                                stop:1 #150a26);
}

QStackedWidget, QWidget#page1_2, QWidget#page2_2 {
    background: transparent;
}

/* ============ 标题 ============ */
QLabel#label, QLabel#label_2 {
    color: #eaf9ff;
    font-weight: 800;
}

/* ============ 输入框 ============ */
QLineEdit {
    background-color: rgba(6, 18, 34, 205);
    color: #dcf3ff;
    border: 1px solid rgba(70, 190, 255, 80);
    border-radius: 6px;
    padding: 4px 12px;
    selection-background-color: #00cfff;
    selection-color: #04101f;
}
QLineEdit:hover {
    border: 1px solid rgba(70, 200, 255, 150);
}
QLineEdit:focus {
    border: 1px solid #00d9ff;
    background-color: rgba(0, 45, 80, 225);
}

/* ============ 主按钮（登录 / 确认） ============ */
QPushButton {
    color: #f0ffff;
    border: 1px solid rgba(140, 235, 255, 130);
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1fb6ff, stop:1 #0b5ed7);
    font-weight: 700;
    padding: 4px 10px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4bd2ff, stop:1 #1478ff);
    border: 1px solid rgba(200, 250, 255, 210);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0a86c9, stop:1 #06367c);
}
QPushButton:disabled {
    color: rgba(220, 240, 255, 90);
    background: rgba(40, 60, 90, 160);
    border: 1px solid rgba(120, 160, 200, 60);
}

/* ============ 次要按钮：修改密码（描边风） ============ */
QPushButton#btnChangePassword {
    background: transparent;
    color: #7fe0ff;
    border: 1px solid rgba(90, 205, 255, 150);
}
QPushButton#btnChangePassword:hover {
    background: rgba(0, 170, 255, 45);
    border: 1px solid #63dcff;
    color: #d6f7ff;
}
QPushButton#btnChangePassword:pressed {
    background: rgba(0, 120, 200, 80);
}

/* ============ 密码可见按钮 ============ */
QToolButton#toolBtnPassword {
    background-color: rgba(6, 18, 34, 205);
    border: 1px solid rgba(70, 190, 255, 80);
    border-radius: 6px;
    color: #7fe0ff;
    font-size: 13px;
}
QToolButton#toolBtnPassword:hover {
    border: 1px solid #00d9ff;
    background-color: rgba(0, 55, 95, 225);
    color: #eaffff;
}
QToolButton#toolBtnPassword:pressed {
    background-color: rgba(0, 90, 150, 230);
}
/* 想换成图标时，把上面 QToolButton#toolBtnPassword 的三行 background 换成：
   background-image: url(:/icons/eye.png);
   background-repeat: no-repeat;
   background-position: center;
*/</string>
