  <property name="styleSheet">
   <string notr="true">/* 登录窗口整体背景（假设窗口的 objectName 为 LogIn） */
QWidget#LogIn {
    /* 浅色渐变：从浅蓝到浅紫（可根据喜好调整颜色） */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #cce5ff, stop:1 #e6d1ff); 
}

/* 输入框通用样式 */
QLineEdit {
    background-color: white;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 8px;
}

QLineEdit:focus {
    border: 1px solid #66a3ff;
    outline: none;
}

/* 按钮通用样式 - 蓝色背景、白色文字 */
QPushButton {
    background-color: #1976d2; /* 蓝色，可调整为 #2196f3 等 */
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 10px;
}

QPushButton:hover {
    background-color: #1565c0; /* hover 时加深蓝色 */
}

QPushButton:pressed {
    background-color: #0d47a1; /* 按下时进一步加深蓝色 */
}

QToolButton {
            border: none;
            background: transparent;
            font-size: 13px;
            padding: 1px;
            min-width: 20px;
}
/* 如果需要区分 “Change Password” 按钮（可选） 
QPushButton#ChangePasswordBtn {
    padding: 6px 10px;
    font-size: 12px;
}*/</string>
