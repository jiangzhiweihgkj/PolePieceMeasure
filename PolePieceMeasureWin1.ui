    padding: 4px 16px;
    border-radius: 6px;
}

/* 禁用状态 */
QGroupBox:disabled {
    border-color: #A5B7C6;  /* 工业蓝灰 */
    color: #95A5A6;
}

QGroupBox QCheckBox {
    color: #274472; /* 深钢蓝，与标题呼应 */
}
