  <property name="styleSheet">
   <string notr="true">/* ========== 全局 ========== */
QMainWindow#PolePieceMeasureWinClass,
QWidget#centralWidget {
    background-color: #1B1F27;
    color: #E6EAF0;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 15px;
}

/* ========== 顶部操作栏按钮（默认深色工业按钮） ========== */
QPushButton {
    color: #E6EAF0;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #2E3542, stop:1 #232833);
    border: 1px solid #3A4252;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 20px;
    font-weight: bold;
    min-height: 28px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #384152, stop:1 #2A3140);
    border: 1px solid #4FC3DD;
    color: #7FD4E8;
}
QPushButton:pressed {
    background-color: #1A1E26;
    border: 1px solid #2C7A8C;
    color: #4FC3DD;
}
QPushButton:disabled {
    background-color: #20242C;
    color: #5A6270;
    border: 1px solid #2A303A;
}

/* ========== 主按钮（开始 / 识别 / 导入） ========== */
QPushButton#btnStartCollectPoint,
QPushButton#btnRecoCloud,
QPushButton#btnLoadCloud {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #2C8AA0, stop:1 #236E80);
    border: 1px solid #4FC3DD;
    color: #FFFFFF;
}
QPushButton#btnStartCollectPoint:hover,
QPushButton#btnRecoCloud:hover,
QPushButton#btnLoadCloud:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #37A4BF, stop:1 #2C8AA0);
    border: 1px solid #7FD4E8;
    color: #FFFFFF;
}

/* ========== 危险按钮（暂停 / 停止） ========== */
QPushButton#btnSavePoint,
QPushButton#btnStopCollectPoint {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #6B2E38, stop:1 #55232C);
    border: 1px solid #C24A5A;
    color: #FFD5DB;
}
QPushButton#btnSavePoint:hover,
QPushButton#btnStopCollectPoint:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #8A3B47, stop:1 #6B2E38);
    border: 1px solid #E86A7B;
    color: #FFFFFF;
}

/* ========== 设置 / 登录（强调次按钮） ========== */
QPushButton#btnSignIn_5,
QPushButton#btnSignIn {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #3A4252, stop:1 #2B3240);
    border: 1px solid #4FC3DD;
    color: #7FD4E8;
}
QPushButton#btnSignIn_5:hover,
QPushButton#btnSignIn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #465066, stop:1 #333A4A);
    border: 1px solid #7FD4E8;
    color: #A8E6F5;
}

/* ========== CheckBox ========== */
QCheckBox {
    color: #C7CFDB;
    spacing: 8px;
    font-size: 15px;
    font-weight: bold;
}
QCheckBox::indicator {
    width: 20px; height: 20px;
    border: 1px solid #3A4252;
    border-radius: 4px;
    background-color: #1A1E26;
}
QCheckBox::indicator:hover { border: 1px solid #4FC3DD; }
QCheckBox::indicator:checked {
    background-color: #2C8AA0;
    border: 1px solid #4FC3DD;
    image: none;
}

/* ========== 通用 GroupBox（浅色内容区不动，仅卡片外框统一） ========== */
QGroupBox {
    border-radius: 10px;
    margin-top: 20px;
    padding: 8px;
}

/* ========== QTableWidget 全局深色主题 ========== */
QTableWidget {
    background-color: #1A1E26;
    alternate-background-color: #20252F;
    gridline-color: #2F3644;
    border: 1px solid #2F3644;
    border-radius: 6px;
    color: #E6EAF0;
    selection-background-color: #2C7A8C;
    selection-color: #FFFFFF;
}
QTableWidget::item {
    padding: 6px 10px;
    border: none;
}
QTableWidget::item:selected,
QTableWidget::item:selected:focus,
QTableWidget::item:selected:!focus {
    background-color: #2C7A8C !important;
    color: #FFFFFF !important;
}
QTableWidget::item:hover {
    background-color: #2A313F;
}
QHeaderView::section {
    background-color: #232833;
    color: #7FD4E8;
    padding: 6px 10px;
    border: 1px solid #2F3644;
    font-weight: bold;
}

/* ========== QTextEdit（日志） ========== */
QTextEdit {
    background-color: #1A1E26;
    border: 1px solid #2F3644;
    border-radius: 6px;
    padding: 6px;
    color: #C7CFDB;
    font-family: &quot;Consolas&quot;, &quot;SimSun&quot;;
}
QTextEdit:focus { border: 1px solid #4FC3DD; }

/* ========== 滚动条 ========== */
QScrollBar:vertical {
    background: #1A1E26; width: 10px; border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #3A4252; border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4FC3DD; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ========== 顶部状态栏 OK/NG 大标签 ========== */
QLabel#label_2, QLabel#label_3 {
    color: #4ADE80;
    font-size: 22px;
    font-weight: bold;
}
QLabel#label, QLabel#label_4 {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
}
</string>
