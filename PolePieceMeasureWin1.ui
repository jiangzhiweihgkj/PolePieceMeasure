}

QGroupBox::title {
    color: #FFFFFF;
    background-color: #274472; /* 深钢蓝，科技感强 */
    font: 75 12pt &quot;Microsoft YaHei UI&quot;;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 16px;
    border-radius: 6px;
}

