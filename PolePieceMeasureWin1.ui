      <property name="styleSheet">
       <string notr="true">QPushButton {
    color: rgb(240, 240, 240);  
    background-color: rgb(15, 15, 15); 
    border: 1.5px solid rgba(37, 42, 50, 0.3);
    border-radius: 4px; 
    outline: none;
    transition: all 0.15s ease-in-out;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: rgb(162, 162, 162);       /* 悬停时背景加深，工业感加强 */
    border: 1.5px solid rgba(37, 42, 50, 0.5); /* 边框稍加深 */
}

QPushButton:pressed {
    background-color: #252A32;       /* 按下时暗灰金属色 */
    color: #C8CDD1;                  /* 字体变浅，反差适中 */
    border: 1.5px solid rgba(200, 205, 209, 0.7);
}

QPushButton:disabled {
    background-color: #E3E7EB;       /* 失活时浅灰蓝 */
    color: #A0A6AC;                  /* 文字灰度较低 */
    border: 1.5px solid rgba(37, 42, 50, 0.15);
}
</string>
