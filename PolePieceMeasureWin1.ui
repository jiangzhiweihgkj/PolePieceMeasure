      <property name="styleSheet">
       <string notr="true">QGroupBox {
    background-color: rgb(207, 207, 207); /* 浅灰主色 */
    border: 1.5px solid rgb(207, 207, 207); /* 和背景色相同的边框 */
    padding-top: 15px; 
    margin-top: -15px;
}

/* 标题区域高度为0，即不可见 */
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    height: 0px;
    color: transparent;
    background: transparent;
    border: none;
}


/* 禁用状态边框变浅，内容变淡 */
QGroupBox:disabled {
    border-color: #D3D4D6;
    color: #A0A0A0;
}

QGroupBox QCheckBox, QGroupBox QLabel, QGroupBox QPushButton {
    color: rgb(0, 0, 0); /* 深灰内容字体，突出可用性 */
}
</string>
