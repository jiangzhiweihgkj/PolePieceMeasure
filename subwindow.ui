  <property name="styleSheet">
   <string notr="true">/* ========== 全局 ========== */
QWidget#SubWindowClass {
    background-color: #1B1F27;
    color: #E6EAF0;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 15px;
}

/* ========== GroupBox 卡片 ========== */
QGroupBox {
    background-color: #232833;
    border: 1px solid #2F3644;
    border-radius: 10px;
    margin-top: 18px;
    padding: 14px 12px 12px 12px;
    font-size: 16px;
    font-weight: bold;
    color: #7FD4E8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 8px;
    background-color: #232833;
    border-radius: 4px;
}

/* ========== Label ========== */
QLabel {
    color: #C7CFDB;
    background: transparent;
    font-size: 15px;
}
QLabel[state=&quot;connected&quot;]    { color: #4ADE80; font-weight: bold; }
QLabel[state=&quot;disconnected&quot;] { color: #F87171; font-weight: bold; }
QLabel[state=&quot;connecting&quot;]   { color: #FBBF24; font-weight: bold; }

/* ========== LineEdit ========== */
QLineEdit {
    background-color: #1A1E26;
    border: 1px solid #323A48;
    border-radius: 6px;
    padding: 6px 10px;
    color: #E6EAF0;
    selection-background-color: #2C7A8C;
    selection-color: #FFFFFF;
}
QLineEdit:hover { border: 1px solid #3D4759; }
QLineEdit:focus {
    border: 1px solid #4FC3DD;
    background-color: #1F2530;
}

/* ========== 按钮 - 基础 ========== */
QPushButton {
    color: #E6EAF0;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #2E3542, stop:1 #232833);
    border: 1px solid #3A4252;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 15px;
    font-weight: bold;
    min-height: 28px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #384152, stop:1 #2A3140);
    border: 1px solid #4FC3DD;
    color: #7FD4E8;
}
QPushButton:pressed {
    background-color: #1A1E26;
    border: 1px solid #2C7A8C;
    color: #4FC3DD;
}
QPushButton:disabled {
    background-color: #20242C;
    color: #5A6270;
    border: 1px solid #2A303A;
}

/* ========== 主按钮（连接/开始采集/保存参数） ========== */
QPushButton#btnConnectCamera,
QPushButton#btnConnectCamera_B,
QPushButton#btnConnectPLC,
QPushButton#btnStartCollectPoint,
QPushButton#btnParamSave {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #2C8AA0, stop:1 #236E80);
    border: 1px solid #4FC3DD;
    color: #FFFFFF;
}
QPushButton#btnConnectCamera:hover,
QPushButton#btnConnectCamera_B:hover,
QPushButton#btnConnectPLC:hover,
QPushButton#btnStartCollectPoint:hover,
QPushButton#btnParamSave:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #37A4BF, stop:1 #2C8AA0);
    border: 1px solid #7FD4E8;
    color: #FFFFFF;
}
QPushButton#btnConnectCamera:pressed,
QPushButton#btnConnectCamera_B:pressed,
QPushButton#btnConnectPLC:pressed,
QPushButton#btnStartCollectPoint:pressed,
QPushButton#btnParamSave:pressed {
    background-color: #1E5C6B;
    border: 1px solid #2C7A8C;
    color: #C9F0F8;
}

/* ========== 次按钮（浏览/读取参数/备用/数据导出） ========== */
QPushButton#btnOutPutDirectory,
QPushButton#btnOutPutDirectory_Result,
QPushButton#btnParamRead,
QPushButton#btnSavePoint,
QPushButton#pushButton_2 {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #3A4252, stop:1 #2B3240);
    border: 1px solid #4FC3DD;
    color: #7FD4E8;
}
QPushButton#btnOutPutDirectory:hover,
QPushButton#btnOutPutDirectory_Result:hover,
QPushButton#btnParamRead:hover,
QPushButton#btnSavePoint:hover,
QPushButton#pushButton_2:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #465066, stop:1 #333A4A);
    border: 1px solid #7FD4E8;
    color: #A8E6F5;
}

/* ========== 危险按钮（断开/停止采集） ========== */
QPushButton#btnDisConnectCamera,
QPushButton#btnDisConnectCamera_B,
QPushButton#btnDisConnectPLC,
QPushButton#btnStopCollectPoint {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #6B2E38, stop:1 #55232C);
    border: 1px solid #C24A5A;
    color: #FFD5DB;
}
QPushButton#btnDisConnectCamera:hover,
QPushButton#btnDisConnectCamera_B:hover,
QPushButton#btnDisConnectPLC:hover,
QPushButton#btnStopCollectPoint:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #8A3B47, stop:1 #6B2E38);
    border: 1px solid #E86A7B;
    color: #FFFFFF;
}
QPushButton#btnDisConnectCamera:pressed,
QPushButton#btnDisConnectCamera_B:pressed,
QPushButton#btnDisConnectPLC:pressed,
QPushButton#btnStopCollectPoint:pressed {
    background-color: #44191F;
    border: 1px solid #A33A48;
}

/* ========== 滚动条 ========== */
QScrollBar:vertical {
    background: #1A1E26;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #3A4252;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4FC3DD; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
</string>
