  <property name="styleSheet">
   <string notr="true">/* ========== 全局背景：深空渐变 ========== */
QWidget#SubWindowClass {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #060b14,
                                stop:0.45 #0a1526,
                                stop:1 #0d0a1a);
    color: #e6edf7;
    font-family: &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;;
    font-size: 14px;
}

/* ========== 卡片面板 ========== */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #141e30,
                                stop:1 #0c1422);
    border: 1px solid #2d4164;
    border-top: 1px solid #22d3ee;
    border-radius: 12px;
    margin-top: 22px;
    padding: 20px 16px 16px 16px;
    color: #22d3ee;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 4px 14px;
    background-color: #0a1422;
    border: 1px solid #22d3ee;
    border-radius: 11px;
    color: #67e8f9;
}

/* ========== 普通 Label ========== */
QLabel {
    color: #b8c4d8;
    background: transparent;
}

/* ========== 连接状态徽章 ========== */
QLabel[state=&quot;connected&quot;] {
    color: #6ee7b7;
    background-color: #102a20;
    border: 1px solid #10b981;
    border-radius: 10px;
    padding: 2px 12px;
}
QLabel[state=&quot;unconnected&quot;],
QLabel[state=&quot;disconnected&quot;] {
    color: #fca5a5;
    background-color: #2b1215;
    border: 1px solid #ef4444;
    border-radius: 10px;
    padding: 2px 12px;
}
QLabel[state=&quot;connecting&quot;] {
    color: #fcd34d;
    background-color: #2b1f0a;
    border: 1px solid #f59e0b;
    border-radius: 10px;
    padding: 2px 12px;
}

/* ========== 输入框 ========== */
QLineEdit {
    background-color: #08101a;
    border: 1px solid #2d4164;
    border-radius: 8px;
    padding: 5px 12px;
    color: #eaf2ff;
    selection-background-color: #22d3ee;
    selection-color: #04101f;
}
QLineEdit:hover {
    border: 1px solid #22d3ee;
}
QLineEdit:focus {
    border: 1px solid #22d3ee;
    background-color: #081426;
}
QLineEdit:disabled {
    color: #5a6270;
    background-color: #141a26;
    border: 1px solid #283246;
}

/* ========== 按钮基础 ========== */
QPushButton {
    color: #eaf2ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #26324a,
                                stop:1 #16202f);
    border: 1px solid #3c5073;
    border-radius: 9px;
    padding: 6px 18px;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #334262,
                                stop:1 #1e2b40);
    border: 1px solid #22d3ee;
    color: #a5f3fc;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #101827,
                                stop:1 #0a121e);
    border: 1px solid #22d3ee;
    color: #67e8f9;
}
QPushButton:disabled {
    color: #4b5563;
    background: #1c2634;
    border: 1px solid #283246;
}

/* ========== 主按钮：连接相机/PLC ========== */
QPushButton#btnConnectCamera,
QPushButton#btnConnectCamera_B,
QPushButton#btnConnectPLC {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0ea5c4, stop:1 #0a6e85);
    border: 1px solid #67e8f9;
    color: #ffffff;
}
QPushButton#btnConnectCamera:hover,
QPushButton#btnConnectCamera_B:hover,
QPushButton#btnConnectPLC:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #22d3ee, stop:1 #0891b2);
    border: 1px solid #a5f3fc;
    color: #04202b;
}
QPushButton#btnConnectCamera:pressed,
QPushButton#btnConnectCamera_B:pressed,
QPushButton#btnConnectPLC:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0891b2, stop:1 #065b72);
    border: 1px solid #22d3ee;
    color: #eafbff;
}

/* ========== 开始采集：翠绿强调 ========== */
QPushButton#btnStartCollectPoint {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #10b981, stop:1 #047857);
    border: 1px solid #6ee7b7;
    color: #ffffff;
}
QPushButton#btnStartCollectPoint:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #34d399, stop:1 #059669);
    border: 1px solid #a7f3d0;
    color: #022c22;
}
QPushButton#btnStartCollectPoint:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #059669, stop:1 #065f46);
    border: 1px solid #10b981;
    color: #ecfdf5;
}

/* ========== 次按钮：浏览/读取/备用/导出/保存参数 ========== */
QPushButton#btnOutPutDirectory,
QPushButton#btnOutPutDirectory_Result,
QPushButton#btnParamRead,
QPushButton#btnSavePoint,
QPushButton#btnParamSave,
QPushButton#pushButton_2 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2545,
                                stop:1 #1a1830);
    border: 1px solid #8b5cf6;
    color: #c4b5fd;
}
QPushButton#btnOutPutDirectory:hover,
QPushButton#btnOutPutDirectory_Result:hover,
QPushButton#btnParamRead:hover,
QPushButton#btnSavePoint:hover,
QPushButton#btnParamSave:hover,
QPushButton#pushButton_2:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3d3570,
                                stop:1 #241f45);
    border: 1px solid #a78bfa;
    color: #ede9fe;
}
QPushButton#btnOutPutDirectory:pressed,
QPushButton#btnOutPutDirectory_Result:pressed,
QPushButton#btnParamRead:pressed,
QPushButton#btnSavePoint:pressed,
QPushButton#btnParamSave:pressed,
QPushButton#pushButton_2:pressed {
    background: #1a1830;
    border: 1px solid #7c3aed;
    color: #c4b5fd;
}

/* ========== 危险按钮：断开/停止采集 ========== */
QPushButton#btnDisConnectCamera,
QPushButton#btnDisConnectCamera_B,
QPushButton#btnDisConnectPLC,
QPushButton#btnStopCollectPoint {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #b91c1c, stop:1 #6b0f0f);
    border: 1px solid #fca5a5;
    color: #ffffff;
}
QPushButton#btnDisConnectCamera:hover,
QPushButton#btnDisConnectCamera_B:hover,
QPushButton#btnDisConnectPLC:hover,
QPushButton#btnStopCollectPoint:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ef4444, stop:1 #991b1b);
    border: 1px solid #fecaca;
    color: #2b0505;
}
QPushButton#btnDisConnectCamera:pressed,
QPushButton#btnDisConnectCamera_B:pressed,
QPushButton#btnDisConnectPLC:pressed,
QPushButton#btnStopCollectPoint:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #991b1b, stop:1 #450a0a);
    border: 1px solid #ef4444;
    color: #fee2e2;
}

/* ========== 滚动条 ========== */
QScrollBar:vertical {
    background: #0f1727;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #2d4164;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #22d3ee; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }</string>
